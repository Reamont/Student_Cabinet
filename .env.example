# Example only. Generate unique values; never commit a populated .env.
# Local development: scripts/dev.sh creates ignored var/dev.env automatically.
APP_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=campus.example.org,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://campus.example.org
# URL-safe random password; must match the database URL if setting it manually.
POSTGRES_PASSWORD=replace-with-random-url-safe-password
DATABASE_URL=postgresql://campus:replace-with-random-url-safe-password@db:5432/campus
# First seed only. Different random passwords of at least 12 characters.
DEMO_STUDENT_PASSWORD=replace-with-random-student-password
DEMO_SECOND_PASSWORD=replace-with-another-random-student-password
DEMO_STAFF_PASSWORD=replace-with-private-random-staff-password

# Set to 1 only behind deploy/nginx.conf; Compose sets this explicitly.
LOGIN_RATE_LIMIT_AT_PROXY=0
